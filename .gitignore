# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local environment
.env
.env.*
!.env.example

# Node / frontend
node_modules/
web/node_modules/
dist/
web/dist/
web/.vite/
web/tsconfig.tsbuildinfo
*.fuse_hidden*

# Runtime logs and local process output
*.log
*.err
*.err.log
frontend-runtime.log
server-runtime.log
server-runtime.err.log
web/*-runtime.log
web/*-runtime.err.log

# Generated runs, uploads, and temporary validation files
runs/
**/runs/
demo_artifacts/uploads/
docs/.lo_profile*/
docs/_manual_render/
docs/_render*/
docs/minimal_render_test.docx
docs/*_render_test.*

# Large local training artifacts and model checkpoints
**/*.safetensors
**/lejit_bundle/model/
**/lejit_bundle/trainer/
**/optimizer.pt
**/scheduler.pt
**/rng_state.pth
**/training_args.bin
forge/rulesets/*/20*/
forge/rulesets/*/generated*.csv
# Small rule/reference samples under forge/rulesets are intentionally tracked.

# Raw local data drops
data/*.csv
data/*.pcap

# Project documentation policy
# Keep only the curated root docs and demo operator docs listed in README.
# Already tracked files require `git rm --cached` if they should leave the index.
docs/
web/README.md
agents/
skills/
.claude/
AI_WORKSITE_HANDOFF.md
CLAUDE_HANDOFF.md
FORGE_STATUS_MAP.*
FORGE_GIT_PIPELINE.*
demo_artifacts/w4_demo_assets/**/references/*.md
forge/scenarios/**/README.md
tools/render_forge_*.py

# Local dependency working trees are vendored under the repo, but their local
# virtualenvs, build outputs, and nested VCS metadata must never be committed.
NetNomos/.git/
NetNomos/.venv/
NetNomos/.pytest_cache/
NetNomos/netnomos.egg-info/
LeJIT/.git/
LeJIT/.venv/
LeJIT/.pytest_cache/
