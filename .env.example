# NetNomos Forge environment example

# Backend logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_CONSOLE_LEVEL=INFO

# Frontend logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_FRONTEND_LOGS=true

# API
VITE_API_BASE=http://localhost:8000

# Optional LLM settings
# FORGE_RULECARD_LLM=true
# FORGE_RULECARD_LLM_MAX_CARDS=2
# FORGE_OLLAMA_HOST=http://localhost:11434
# FORGE_OLLAMA_EXPLAIN_MODEL=gemma3:27b
# FORGE_OLLAMA_DRAFT_MODEL=qwen2.5:14b-instruct
