# NetNomos Forge 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ============================
# 后端日志配置
# ============================
LOG_LEVEL=INFO                    # 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs                      # 日志文件目录（相对于项目根目录）
LOG_JSON=false                    # 是否输出 JSON 格式日志（仅文件）
LOG_MAX_BYTES=10485760           # 单个日志文件最大大小（10MB）
LOG_BACKUP_COUNT=5               # 保留的日志文件数量
LOG_CONSOLE_LEVEL=INFO           # 控制台日志级别（可选，默认与 LOG_LEVEL 相同）

# ============================
# 前端日志配置（仅开发环境）
# ============================
VITE_LOG_LEVEL=debug             # 前端日志级别：debug, info, warn, error

# ============================
# API 配置
# ============================
VITE_API_BASE=http://localhost:8000  # 后端 API 地址

# ============================
# 其他配置
# ============================
# FORGE_RULECARD_LLM=true          # 启用 LLM 规则卡增强
# FORGE_RULECARD_LLM_MAX_CARDS=2   # 最多增强的规则卡数量
# FORGE_OLLAMA_HOST=http://localhost:11434  # Ollama 服务地址
# FORGE_OLLAMA_EXPLAIN_MODEL=gemma3:27b     # 规则解释模型
# FORGE_OLLAMA_DRAFT_MODEL=qwen2.5:14b-instruct  # 报告生成模型
